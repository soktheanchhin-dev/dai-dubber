{
  "name": "dai-dubber",
  "version": "1.0.0",
  "description": "Dai Dubber FREE (Khmer Edition) rebuilt with TypeScript, Next.js and Electron",
  "author": "DaCoding",
  "license": "MIT",
  "private": true,
  "main": "electron/dist/main.js",
  "scripts": {
    "next:dev": "next dev -p 3000",
    "next:build": "next build",
    "electron:build": "tsc -p electron/tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json",
    "dev": "concurrently -k -n NEXT,ELECTRON -c cyan,magenta \"npm:next:dev\" \"npm run electron:build && wait-on tcp:3000 && cross-env DAI_DEV=http://localhost:3000 electron .\"",
    "build": "npm run next:build && npm run electron:build",
    "start": "npm run electron:build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3",
    "lucide-react": "^0.451.0",
    "next": "^14.2.15",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.dacoding.daidubber",
    "productName": "Dai Dubber",
    "files": [
      "electron/dist/**/*",
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../tools",
        "to": "tools",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["portable", "nsis"],
      "icon": "public/icon.ico"
    },
    "directories": {
      "output": "release"
    }
  }
}
